---
import { Dashboard } from '../components/Dashboard';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/todo/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>To-Do List Design</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="flex min-h-screen md:items-center justify-center bg-[#ebf2f5] p-0 antialiased md:p-4"
  >
    <Dashboard client:load />
  </body>
</html>
