---
interface Props {
  icon: string;
  label: string;
  active?: boolean;
}

const { icon, label, active = false } = Astro.props;
---

<a
  href="#"
  class={`flex items-center justify-center md:justify-start gap-3 px-4 md:px-6 py-3 text-sm font-medium transition-colors border-b-2 md:border-b-0 md:border-l-4 ${
    active
      ? 'text-cyan-500 bg-white border-cyan-500 shadow-sm z-10'
      : 'text-gray-400 hover:text-gray-600 border-transparent'
  } ${active ? 'border-cyan-500' : 'border-transparent'}`}
>
  <Fragment set:html={icon} />
  <span class="hidden whitespace-nowrap md:inline">{label}</span>
</a>
