---
interface Props {
  label: string;
  color: 'purple' | 'pink' | 'orange';
}

const { label, color } = Astro.props;

const colorMap = {
  purple: 'bg-[#a28ed4]',
  pink: 'bg-[#ec7bb4]',
  orange: 'bg-[#ec9f73]',
};
---

<button
  class={`px-5 py-1.5 rounded-full text-white text-xs font-medium shadow-sm active:scale-95 transition-transform cursor-pointer ${colorMap[color]}`}
>
  {label}
</button>
